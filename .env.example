# Copia este archivo a .env y rellena con tus valores.
# El .env NO se sube al repositorio (está en .gitignore).

# ─── Supabase (Project Settings → API) ───────────────────────
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# ─── Stripe (dashboard.stripe.com/test/apikeys) ──────────────
# SOLO la clave secreta, y solo la usa el servidor (carpeta /api).
# En pruebas empieza por sk_test_; la de producción por sk_live_.
# NUNCA se pega en un chat, en una captura ni en el código.
STRIPE_SECRET_KEY=sk_test_tu_clave_secreta

# A dónde vuelve el cliente al terminar el pago.
# En local: http://localhost:3000 (el puerto de `vercel dev`).
SITIO_URL=http://localhost:3000

# ─── Webhook de Stripe ───────────────────────────────────────
# Lo da `stripe listen` en local, o el panel de Stripe al crear el endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Supabase: clave de servicio (Project Settings → API) ────
# Se salta las reglas de seguridad de la base de datos: SOLO en el servidor.
# Nunca en el navegador, nunca en un chat.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
