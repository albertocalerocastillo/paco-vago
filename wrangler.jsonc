// Despliegue en Cloudflare Workers (plan gratuito, que SÍ permite uso comercial,
// a diferencia del gratuito de Vercel). Ver ESTADO.md, apartado Cloudflare.
{
  "name": "paco-vago",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Rutas de React (/tienda, /admin…): si no existe el fichero, sirve index.html.
    "not_found_handling": "single-page-application",
    // Solo /api pasa por el Worker; el resto son ficheros estáticos (gratis e ilimitados).
    "run_worker_first": ["/api/*"]
  },
  // Lo que no es secreto va aquí. Los secretos (claves de Stripe y la service_role
  // de Supabase) NUNCA en este fichero: con `npx wrangler secret put NOMBRE`.
  "vars": {
    "VITE_SUPABASE_URL": "https://krjnhnevzpsxpjsnpbjm.supabase.co"
    // SITIO_URL (a dónde vuelve el cliente tras pagar) se pone al desplegar, con
    // la dirección real: primero la de workers.dev, luego https://pacovago.es.
  },
  // Dominio propio (comprado el 23/10/2026, titular el tío, DNS en Cloudflare).
  // Cloudflare crea solo los registros DNS y el certificado de cada uno.
  "routes": [
    { "pattern": "pacovago.es", "custom_domain": true },
    { "pattern": "www.pacovago.es", "custom_domain": true }
  ],
  // La dirección de prueba *.workers.dev sigue viva mientras dure el cambio
  // (el webhook de Stripe en modo prueba apunta ahí).
  "workers_dev": true,
  "observability": { "enabled": true }
}
